PORT=5000
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-chars
JWT_EXPIRES_IN=7d
DATABASE=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/taskManager?retryWrites=true&w=majority

# Email Service Configuration (Nodemailer)
# In development, leave empty to log formatted email previews directly to the terminal,
# or provide your Mailtrap / Gmail SMTP credentials below:
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM="TaskFlow <welcome@taskflow.dev>"
